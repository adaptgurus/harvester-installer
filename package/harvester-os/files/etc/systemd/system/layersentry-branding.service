[Unit]
Description=LayerSentry v1.0 private-label bootstrap
After=rke2-server.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/rancher/rke2/rke2.yaml

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/sbin/layersentry-branding.sh
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
